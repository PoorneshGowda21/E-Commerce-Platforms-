{
  "name": "aura-ecommerce-mern",
  "version": "1.0.0",
  "description": "Production-grade MERN E-Commerce Platform with Dual Interfaces & UPI Gateway",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
    "server": "node --watch server/server.js",
    "client": "npm run dev --prefix client",
    "seed": "node server/seeder.js",
    "build": "npm install --prefix client && npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "mern",
    "ecommerce",
    "react",
    "express",
    "mongodb",
    "vercel"
  ],
  "author": "Senior Full-Stack Engineer"
}
